<Window x:Class="ToDO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDO"
        mc:Ignorable="d"
        Title="ToDoListWPF" Height="450" Width="800">
    <Grid Background="#E1EFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Менеджер Задач"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20" Grid.Column="1">
                <TextBox FontSize="20" x:Name="QuestHelper" />
                <ListBox x:Name="MyListBox" FontSize="18" Height="327" DisplayMemberPath="Title"/>
            </StackPanel>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="*"/>
                    <RowDefinition  Height="200"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                    Content="Добавить" HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontSize="30"
                    Click="AddButton"/>
                <Button Grid.Row="1"
                    Content="Удалить" HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontSize="30"
                    Click="RemoveButton"/>

                
            </Grid>
        </Grid>


    </Grid>
</Window>
